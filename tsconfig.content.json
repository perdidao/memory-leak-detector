{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2015",
    "target": "ES2015",
    "lib": ["ES2015", "DOM"],
    "outDir": "./dist/content",
    "rootDir": "./src/content",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/content/**/*.ts"],
  "exclude": ["src/content/**/*.js"]
}
